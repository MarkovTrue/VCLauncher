[Hotkeys]
1=Video-compare hotkeys
2={H} Control hints
3={V} Video info
4={LEFT}{RIGHT} Seek ±1 sec
5={UP}{DOWN} Seek ±15 sec
6={F} Save frames as PNG
7={3} Show/hide HUD
8={0} Video/subtraction mode
9={Y} Toggle subtraction mode
10={PLUS}{MINUS} Shift ±1 frame
11={CTRL}{PLUS}{MINUS} Shift ±10 frames
12={ALT}{PLUS}{MINUS} Shift ±100 frames
13={6}{7} Zoom 100/200%
14={1}{2} Hide video
15={A}{D} Frame step
16={J}{L} Speed ±
17={Z}{C} Magnify area
18={R} Reset zoom
19={S} Swap videos

[Sync]
StatusNotRun=Detected when the comparison starts
StatusManual=A negative value shifts the second video back
